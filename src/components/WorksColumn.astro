---
import { getCollection } from 'astro:content';
import WorkCard from './WorkCard.astro';
import { sortWorks } from '../lib/sort';
import { workCategories } from '../lib/categories';

const all = sortWorks(await getCollection('works', ({ data }) => !data.draft));
const items = all.slice(0, 15); // 全部装得下就不显示"查看更多"
---

<section class="col works">
  <div class="col-head">
    <a class="col-title" href="/works/">Works<span class="arrow">↗</span></a>
    <div class="chips">
      {Object.values(workCategories).map((c) => (
        <a class="chip" href={c.path}>{c.label}</a>
      ))}
    </div>
  </div>
  {items.map((w) => <WorkCard entry={w} />)}
  {all.length > items.length && <a class="more" href="/works/">查看更多 →</a>}
</section>
