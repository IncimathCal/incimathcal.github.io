---
import type { CollectionEntry } from 'astro:content';
import PlatformIcon from './PlatformIcon.astro';
import { coverClass } from '../lib/cover';
import { workCategories } from '../lib/categories';

interface Props {
  entry: CollectionEntry<'works'>;
}

const { entry } = Astro.props;
const d = entry.data;
// 外链直跳；站内作品跳自己的详情页（src/pages/works/[category]/[id].astro）
const href = d.externalUrl ?? `/works/${d.category}/${entry.id}/`;
const dateStr = d.date.toISOString().slice(0, 10);
const cat = workCategories[d.category];
const arrow = d.externalUrl ? '↗' : '→';
---

<a
  class="card"
  href={href}
  target={d.externalUrl ? '_blank' : undefined}
  rel={d.externalUrl ? 'noopener noreferrer' : undefined}
>
  <div
    class={`cover ${coverClass(entry.id, d.cover)}`}
    style={d.cover ? `background-image:url('${d.cover}')` : undefined}
  >
  </div>
  <div class="card-body">
    <div class="meta">
      <span class={`badge-cat cat-${d.category}`}>{cat.label}</span>
      {dateStr}
      {d.linkLabel && <span class="right work-link">{d.linkLabel} {arrow}</span>}
    </div>
    <h3>
      <span class="t">{d.title}</span>
      {d.externalUrl && <PlatformIcon label={d.externalSource} />}
    </h3>
    <div class="summary">{d.summary}</div>
  </div>
</a>
